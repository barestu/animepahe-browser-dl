{
  "name": "animepahe-browser-dl",
  "version": "1.0.0",
  "description": "Batch-download anime episodes from an open animepahe page (Chrome MV3 extension)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "barestu",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barestu/animepahe-browser-dl.git"
  },
  "homepage": "https://github.com/barestu/animepahe-browser-dl#readme",
  "bugs": {
    "url": "https://github.com/barestu/animepahe-browser-dl/issues"
  },
  "scripts": {
    "copy:ffmpeg": "node scripts/copy-ffmpeg.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "dev": "pnpm copy:ffmpeg && pnpm gen:icons && vite",
    "build": "pnpm copy:ffmpeg && pnpm gen:icons && tsc --noEmit && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "zip": "node scripts/zip.mjs",
    "release:notes": "node scripts/changelog.mjs draft"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/chrome": "^0.0.278",
    "@types/node": "^22.7.5",
    "sharp": "^0.33.5",
    "svelte": "^4.2.19",
    "svelte-check": "^3.8.6",
    "tslib": "^2.7.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1"
  }
}
